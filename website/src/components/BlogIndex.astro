---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { chrome, dateLocale, localePath, withBase, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = chrome[lang];
const base = import.meta.env.BASE_URL;
const posts = (await getCollection('blog', ({ data }) => data.lang === lang)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
const dateFormatter = new Intl.DateTimeFormat(dateLocale(lang), {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout lang={lang} title={t.blogIndexTitle} description={t.blogIndexDescription}>
  <section class="page-hero">
    <div class="container page-heading">
      <div class="eyebrow">{t.blogIndexEyebrow}</div>
      <h1 set:html={t.blogIndexHeading} />
      <p>{t.blogIndexText}</p>
    </div>
  </section>

  <section class="container posts">
    {posts.map((post, index) => (
      <a class:list={['post-card', { featured: index === 0 }]} href={withBase(base, localePath(lang, `/blog/${post.id}/`))}>
        <div class="post-number">{String(index + 1).padStart(2, '0')}</div>
        <div class="post-copy">
          <div class="post-meta">
            <time datetime={post.data.publishedAt.toISOString()}>{dateFormatter.format(post.data.publishedAt)}</time>
            <span>{post.data.readingTime}</span>
          </div>
          <h2>{post.data.title}</h2>
          <p>{post.data.description}</p>
        </div>
        <span class="post-arrow">↗</span>
      </a>
    ))}
  </section>
</BaseLayout>

<style>
  .posts {
    display: grid;
    gap: 16px;
    padding-bottom: 110px;
  }

  .post-card {
    position: relative;
    display: grid;
    min-height: 250px;
    grid-template-columns: 110px 1fr;
    align-items: end;
    gap: 26px;
    padding: 38px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--panel);
    transition: border-color 160ms ease, transform 160ms ease;
  }

  .post-card:hover {
    border-color: rgba(255, 113, 132, 0.45);
    transform: translateY(-3px);
  }

  .post-card.featured {
    min-height: 370px;
    background:
      radial-gradient(circle at 82% 15%, rgba(255, 24, 56, 0.22), transparent 28%),
      linear-gradient(135deg, rgba(58, 16, 28, 0.92), rgba(10, 18, 32, 0.92));
  }

  .post-number {
    color: #5c3a48;
    font-size: 55px;
    font-weight: 800;
    line-height: 1;
  }

  .post-copy {
    max-width: 720px;
  }

  .post-meta {
    display: flex;
    gap: 22px;
    color: var(--blue-light);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
  }

  h2 {
    margin: 14px 0 13px;
    font-size: clamp(27px, 4vw, 42px);
    line-height: 1.15;
    letter-spacing: -0.04em;
  }

  p {
    max-width: 670px;
    margin: 0;
    color: var(--muted);
    font-size: 14px;
  }

  .post-arrow {
    position: absolute;
    top: 32px;
    right: 34px;
    color: var(--blue-light);
    font-size: 20px;
  }

  @media (max-width: 620px) {
    .post-card {
      min-height: 300px;
      grid-template-columns: 1fr;
      gap: 25px;
      padding: 27px;
    }

    .post-card.featured {
      min-height: 390px;
    }

    .post-number {
      font-size: 40px;
    }
  }
</style>
