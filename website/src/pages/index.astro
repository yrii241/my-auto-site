---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import icon from '../../../assets/play_store_icon_512.png';
import garage from '../../../assets/play_listing_phone/01_garage.jpg';
import car from '../../../assets/play_listing_phone/02_car.jpg';
import repairs from '../../../assets/play_listing_phone/03_repairs.jpg';
import fuel from '../../../assets/play_listing_phone/04_fuel.jpg';
import stats from '../../../assets/play_listing_phone/05_stats_chart.jpg';
import ai from '../../../assets/play_listing_phone/06_ai_bmw.jpg';
import heroBackground from '../../../assets/site/hero-sunset.jpg';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const playUrl = 'https://play.google.com/store/apps/details?id=com.urijakusenko.myauto';

const features = [
  {
    number: '01',
    icon: '⌁',
    title: 'Весь гараж в одном месте',
    text: 'Добавляйте автомобили, фиксируйте пробег, VIN, фотографии и основные сведения. Нужная информация всегда под рукой.',
    accent: 'red',
    image: garage,
    imageAlt: 'Экран гаража со списком автомобилей',
    purpose: 'Создать отдельную цифровую карточку для каждого автомобиля и не смешивать данные разных машин.',
    situations: [
      'В семье несколько автомобилей — у каждого будет своя история.',
      'Нужно быстро найти VIN, номер, год выпуска или актуальный пробег.',
      'Планируете продать машину и хотите показать аккуратный журнал владения.',
    ],
    steps: [
      'Нажмите «Добавить автомобиль» и укажите основные сведения.',
      'Добавьте фотографию, VIN и текущий пробег.',
      'Откройте карточку автомобиля, чтобы перейти к ремонтам, заправкам и статистике.',
    ],
    result: 'Вместо заметок и разрозненных фотографий — понятная карточка автомобиля со всей связанной информацией.',
  },
  {
    number: '02',
    icon: '⌘',
    title: 'История без пробелов',
    text: 'Записывайте обслуживание и ремонт с датой, стоимостью, пробегом, описанием работ и фотографиями.',
    accent: 'orange',
    image: repairs,
    imageAlt: 'Хронология ремонтов и обслуживания',
    purpose: 'Сохранить полную хронологию обслуживания: что ремонтировали, когда, на каком пробеге и сколько это стоило.',
    situations: [
      'Нужно вспомнить дату последней замены масла, ремня или тормозов.',
      'Неисправность появилась повторно — можно показать сервису предыдущие работы.',
      'Нужно подтвердить обслуживание фотографиями, чеками или экспортом в PDF.',
    ],
    steps: [
      'Выберите автомобиль и создайте день ремонта.',
      'Укажите пробег, выполненные работы, стоимость и комментарий.',
      'Добавьте фотографии деталей или документов — они останутся рядом с записью.',
    ],
    result: 'Вы видите последовательную историю работ и принимаете решения на основе фактов, а не памяти.',
  },
  {
    number: '03',
    icon: '◉',
    title: 'Расходы на топливо',
    text: 'Контролируйте заправки, цену литра и общие расходы. Статистика помогает увидеть реальную стоимость владения.',
    accent: 'green',
    image: fuel,
    imageAlt: 'Сводка и история заправок',
    purpose: 'Понимать, сколько топлива и денег действительно требует автомобиль за выбранный период.',
    situations: [
      'Хотите видеть общую сумму и количество заправок.',
      'Сравниваете цены на разных АЗС или расходы за разные месяцы.',
      'Нужно сохранить пробег, литры, стоимость и заметку по каждой заправке.',
    ],
    steps: [
      'После заправки внесите дату и показания одометра.',
      'Укажите количество литров, общую стоимость и при необходимости заметку.',
      'Откройте статистику, чтобы посмотреть сводные показатели и динамику.',
    ],
    result: 'Расходы перестают быть набором чеков: приложение собирает их в наглядную историю.',
  },
  {
    number: '04',
    icon: '✦',
    title: 'Умный помощник',
    text: 'Получайте подсказки по эксплуатации автомобиля и разбирайтесь в технических вопросах с AI-ассистентом.',
    accent: 'violet',
    image: ai,
    imageAlt: 'Диалог с AI-помощником My Auto',
    purpose: 'Быстро разобраться в симптомах, терминах и возможных действиях с учётом данных вашего автомобиля.',
    situations: [
      'Появился незнакомый звук, индикатор или симптом.',
      'Нужно подготовить список вопросов перед поездкой в сервис.',
      'Хотите понять назначение детали или порядок базовой проверки.',
    ],
    steps: [
      'Откройте помощника из карточки нужного автомобиля.',
      'Опишите ситуацию подробно и при необходимости приложите фотографию.',
      'Получите объяснение и план следующих действий, затем уточните детали в диалоге.',
    ],
    result: 'Вы лучше понимаете проблему и увереннее общаетесь с мастером. Для работы нужен интернет; ответы носят справочный характер и не заменяют диагностику.',
  },
];

const screenshots = [
  { src: garage, alt: 'Гараж с автомобилями в приложении My Auto', label: 'Мой гараж' },
  { src: car, alt: 'Карточка автомобиля со статистикой', label: 'История автомобиля' },
  { src: repairs, alt: 'Список ремонтов автомобиля', label: 'Ремонты' },
  { src: fuel, alt: 'Учёт заправок автомобиля', label: 'Топливо' },
  { src: stats, alt: 'Статистика обслуживания автомобиля', label: 'Статистика' },
  { src: ai, alt: 'AI-помощник My Auto', label: 'AI-помощник' },
];
---

<BaseLayout>
  <section class="hero" style={`--hero-image: url(${heroBackground.src})`}>
    <div class="container hero-grid">
      <div class="hero-copy">
        <div class="eyebrow">Твой автомобиль. Твоя история.</div>
        <h1>Ваш автомобиль<br />заслуживает <span>лучшего!</span></h1>
        <p>
          My Auto — удобный журнал вашего автомобиля. Ремонты, заправки,
          расходы и история обслуживания всегда под рукой.
        </p>
        <div class="hero-actions">
          <a class="button" href={playUrl} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 3.7v16.6c0 .7.8 1.1 1.4.7l10.9-8.3a.9.9 0 0 0 0-1.4L5.4 3c-.6-.4-1.4 0-1.4.7Z" fill="currentColor"/></svg>
            Скачать в Google Play
          </a>
          <a class="watch-link" href="#features">
            <span class="watch-icon" aria-hidden="true">▶</span>
            <span><strong>Смотреть возможности</strong><small>Как это работает</small></span>
          </a>
        </div>
      </div>

      <div class="hero-visual" aria-label="Приложение My Auto">
        <div class="phone phone-front">
          <div class="phone-speaker"></div>
          <Image src={garage} alt="Экран гаража My Auto" widths={[300]} sizes="300px" loading="eager" />
        </div>
      </div>
    </div>
  </section>

  <section class="highlights">
    <div class="container">
      <div class="highlights-heading">
        <div class="eyebrow">Всё, что нужно</div>
        <h2>в одном приложении</h2>
      </div>
      <div class="highlights-grid">
        <button type="button" data-feature-open="feature-02">
          <span class="highlight-icon orange">🔧</span>
          <strong>Ремонты и обслуживание</strong>
          <small>Записывайте работы, пробеги и комментарии.</small>
        </button>
        <button type="button" data-feature-open="feature-03">
          <span class="highlight-icon green">⛽</span>
          <strong>Заправки и расходы</strong>
          <small>Контролируйте расход топлива и бюджет.</small>
        </button>
        <button type="button" data-feature-open="feature-02">
          <span class="highlight-icon blue">📊</span>
          <strong>Графики и аналитика</strong>
          <small>Следите за пробегом и динамикой затрат.</small>
        </button>
        <button type="button" data-feature-open="feature-01">
          <span class="highlight-icon violet">🛡️</span>
          <strong>Ваши данные в безопасности</strong>
          <small>Облачное хранение и резервные копии.</small>
        </button>
        <button type="button" data-feature-open="feature-01">
          <span class="highlight-icon yellow">🚗</span>
          <strong>Несколько авто</strong>
          <small>Ведите историю нескольких машин в одном месте.</small>
        </button>
      </div>
    </div>
  </section>

  <section class="section" id="features">
    <div class="container">
      <div class="section-heading">
        <div class="eyebrow">Как это работает</div>
        <h2>Нажмите карточку —<br />узнаете подробности</h2>
        <p>Каждая возможность открывается с назначением, сценариями применения и коротким порядком действий.</p>
      </div>
      <div class="feature-grid">
        {features.map((feature) => (
          <button
            class={`feature-card ${feature.accent}`}
            type="button"
            data-feature-open={`feature-${feature.number}`}
            aria-haspopup="dialog"
            aria-controls={`feature-${feature.number}`}
          >
            <div class="feature-meta"><span>{feature.icon}</span><small>{feature.number}</small></div>
            <h3>{feature.title}</h3>
            <p>{feature.text}</p>
            <span class="feature-more">Подробнее <i aria-hidden="true">→</i></span>
          </button>
        ))}
      </div>
    </div>
  </section>

  {features.map((feature) => (
    <dialog class={`feature-dialog ${feature.accent}`} id={`feature-${feature.number}`}>
      <div class="dialog-shell">
        <button class="dialog-close" type="button" data-feature-close aria-label="Закрыть описание">×</button>
        <div class="dialog-visual">
          <div class="dialog-number">{feature.number}</div>
          <div class="dialog-phone">
            <Image
              src={feature.image}
              alt={feature.imageAlt}
              widths={[260, 520]}
              sizes="260px"
              loading="lazy"
            />
          </div>
        </div>
        <div class="dialog-content">
          <div class="dialog-kicker"><span>{feature.icon}</span> Возможность My Auto</div>
          <h2>{feature.title}</h2>
          <p class="dialog-purpose">{feature.purpose}</p>

          <div class="dialog-section">
            <h3>Когда пригодится</h3>
            <ul class="dialog-list">
              {feature.situations.map((situation) => <li><span>✓</span>{situation}</li>)}
            </ul>
          </div>

          <div class="dialog-section">
            <h3>Как использовать</h3>
            <ol class="dialog-steps">
              {feature.steps.map((step, index) => (
                <li><span>{index + 1}</span><p>{step}</p></li>
              ))}
            </ol>
          </div>

          <div class="dialog-result">
            <strong>Что вы получаете</strong>
            <p>{feature.result}</p>
          </div>
        </div>
      </div>
    </dialog>
  ))}

  <section class="section showcase" id="screens">
    <div class="container">
      <div class="section-heading showcase-heading">
        <div>
          <div class="eyebrow">Внутри приложения</div>
          <h2>Сложные данные.<br />Простой интерфейс.</h2>
        </div>
        <p>Никаких перегруженных таблиц. Важная информация оформлена так, чтобы её было удобно посмотреть даже одной рукой.</p>
      </div>
      <div class="screen-scroller">
        {screenshots.map((screen, index) => (
          <figure class:list={['screen-item', { raised: index % 2 === 1 }]}>
            <div class="screen-frame">
              <Image src={screen.src} alt={screen.alt} widths={[260, 520]} sizes="260px" loading="lazy" />
            </div>
            <figcaption>{screen.label}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section story">
    <div class="container story-grid">
      <div class="story-visual">
        <div class="story-phone">
          <Image src={repairs} alt="История ремонтов в My Auto" widths={[320, 640]} sizes="320px" />
        </div>
        <div class="story-stat">
          <span>История обслуживания</span>
          <strong>Всегда с вами</strong>
          <div class="story-line"><i></i><i></i><i></i><i></i><i></i></div>
        </div>
      </div>
      <div class="story-copy">
        <div class="eyebrow">Спокойствие в дороге</div>
        <h2>Не вспоминайте.<br />Просто откройте.</h2>
        <p>Когда меняли масло? Сколько стоил последний ремонт? Какой сейчас пробег? Ответы уже записаны и аккуратно разложены по датам.</p>
        <ul>
          <li><span>✓</span> Быстрый поиск по истории работ</li>
          <li><span>✓</span> Фото чеков и деталей рядом с записью</li>
          <li><span>✓</span> Экспорт истории в PDF</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section blog-preview">
    <div class="container">
      <div class="blog-title">
        <div class="section-heading">
          <div class="eyebrow">Полезные материалы</div>
          <h2>Блог My Auto</h2>
        </div>
        <a class="text-link" href={`${base}/blog/`}>Все статьи <span>→</span></a>
      </div>
      <div class="article-grid">
        <a class="article-card article-main" href={`${base}/blog/zachem-vesti-istoriyu-avtomobilya/`}>
          <div class="article-visual"><span>01</span><div class="road-lines"></div></div>
          <div class="article-content">
            <small>Уход за автомобилем · 5 мин</small>
            <h3>Зачем вести историю обслуживания автомобиля</h3>
            <p>Как полная история помогает экономить, планировать ремонт и дороже продать машину.</p>
            <span class="article-arrow">↗</span>
          </div>
        </a>
        <a class="article-card" href={`${base}/blog/kak-kontrolirovat-rashody/`}>
          <div class="article-content">
            <small>Финансы · 4 мин</small>
            <h3>Как понять реальную стоимость владения автомобилем</h3>
            <p>Какие расходы стоит фиксировать помимо топлива.</p>
            <span class="article-arrow">↗</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="section download" id="download">
    <div class="container download-panel">
      <div class="download-glow"></div>
      <Image class="download-icon" src={icon} alt="My Auto" width={86} height={86} />
      <div class="download-copy">
        <div class="eyebrow">Начните сегодня</div>
        <h2>История автомобиля начинается с одной записи.</h2>
        <p>Установите My Auto и сохраните то, что важно для вашей машины.</p>
      </div>
      <a class="button" href={playUrl} target="_blank" rel="noopener">Скачать бесплатно <span>→</span></a>
    </div>
  </section>
</BaseLayout>

<script>
  const openButtons = document.querySelectorAll<HTMLButtonElement>('[data-feature-open]');
  const dialogs = document.querySelectorAll<HTMLDialogElement>('.feature-dialog');

  openButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const dialogId = button.dataset.featureOpen;
      const dialog = dialogId ? document.getElementById(dialogId) : null;

      if (dialog instanceof HTMLDialogElement) {
        dialog.showModal();
      }
    });
  });

  dialogs.forEach((dialog) => {
    dialog.querySelector<HTMLButtonElement>('[data-feature-close]')?.addEventListener('click', () => {
      dialog.close();
    });

    dialog.addEventListener('click', (event) => {
      const bounds = dialog.getBoundingClientRect();
      const isBackdrop =
        event.clientX < bounds.left ||
        event.clientX > bounds.right ||
        event.clientY < bounds.top ||
        event.clientY > bounds.bottom;

      if (isBackdrop) {
        dialog.close();
      }
    });
  });
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: 760px;
    padding: 70px 0 80px;
    background:
      linear-gradient(90deg, rgba(4, 10, 18, 0.78) 0%, rgba(4, 10, 18, 0.28) 36%, rgba(4, 10, 18, 0.04) 58%, transparent 78%),
      linear-gradient(180deg, rgba(4, 10, 18, 0.2) 0%, transparent 24%, rgba(4, 10, 18, 0.42) 100%),
      var(--hero-image) 52% center / cover no-repeat;
  }

  .hero::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, #ff1838 50%, transparent);
    opacity: 0.7;
    content: '';
  }

  .hero-grid {
    display: grid;
    min-height: 560px;
    grid-template-columns: 1.08fr 0.92fr;
    align-items: center;
    gap: 40px;
  }

  h1 {
    max-width: 720px;
    margin: 0 0 24px;
    font-size: clamp(51px, 6.3vw, 82px);
    line-height: 0.96;
    letter-spacing: -0.06em;
  }

  h1 span {
    color: #ff1838;
    text-shadow: 0 12px 40px rgba(255, 24, 56, 0.32);
  }

  .hero-copy > p {
    max-width: 570px;
    margin: 0;
    color: #ced7e5;
    font-size: clamp(16px, 1.7vw, 19px);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 30px;
    margin-top: 34px;
  }

  .hero-actions svg {
    width: 20px;
  }

  .watch-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }

  .watch-icon {
    display: grid;
    width: 48px;
    height: 48px;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.48);
    border-radius: 50%;
    color: white;
    font-size: 13px;
    transition: border-color 160ms ease, background 160ms ease, transform 160ms ease;
  }

  .watch-link:hover .watch-icon {
    border-color: #ff1838;
    background: rgba(255, 24, 56, 0.18);
    transform: scale(1.05);
  }

  .watch-link > span:last-child {
    display: grid;
  }

  .watch-link strong {
    color: white;
    font-size: 13px;
  }

  .watch-link small {
    color: #8495ab;
    font-size: 10px;
  }

  .hero-visual {
    position: relative;
    min-height: 570px;
  }

  .phone {
    position: absolute;
    overflow: hidden;
    border: 10px solid #111318;
    border-radius: 42px;
    background: #111318;
    box-shadow: 0 45px 90px rgba(0, 0, 0, 0.45);
  }

  .phone :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .phone-front {
    z-index: 2;
    top: 8px;
    right: 6%;
    width: 286px;
    height: 584px;
    box-shadow:
      0 40px 90px rgba(0, 0, 0, 0.55),
      0 0 0 1px rgba(255, 255, 255, 0.16);
  }

  .phone-speaker {
    position: absolute;
    z-index: 3;
    top: 10px;
    left: 50%;
    width: 86px;
    height: 22px;
    border-radius: 20px;
    background: #111318;
    transform: translateX(-50%);
  }

  .highlights {
    padding: 78px 0 86px;
    background: #f6f7f9;
    color: #0b1728;
  }

  .highlights-heading {
    margin-bottom: 42px;
    text-align: center;
  }

  .highlights-heading .eyebrow {
    justify-content: center;
    color: var(--red);
  }

  .highlights-heading h2 {
    margin: 0;
    font-size: clamp(34px, 4vw, 52px);
    letter-spacing: -0.045em;
  }

  .highlights-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 14px;
  }

  .highlights-grid button {
    display: grid;
    min-height: 214px;
    padding: 24px 20px 22px;
    border: 1px solid #e7ebf0;
    border-radius: 22px;
    background: white;
    color: inherit;
    cursor: pointer;
    font: inherit;
    text-align: left;
    box-shadow: 0 10px 30px rgba(17, 28, 45, 0.04);
    transition: transform 160ms ease, box-shadow 160ms ease, border-color 160ms ease;
  }

  .highlights-grid button:hover,
  .highlights-grid button:focus-visible {
    border-color: #ffc1c9;
    box-shadow: 0 18px 40px rgba(255, 24, 56, 0.08);
    outline: none;
    transform: translateY(-4px);
  }

  .highlight-icon {
    display: grid;
    width: 52px;
    height: 52px;
    margin-bottom: 22px;
    place-items: center;
    border-radius: 16px;
    background: #fff1f3;
    font-size: 24px;
  }

  .highlight-icon.orange { background: #fff3ea; }
  .highlight-icon.green { background: #e9f9f1; }
